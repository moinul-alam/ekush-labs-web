{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SavingsCertificateTax",
  "type": "object",
  "required": ["meta", "rules"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "dataVersion", "lastVerified", "sources"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "dataVersion": { "type": "string" },
        "lastVerified": { "type": "string" },
        "sources": { "type": "array", "minItems": 1 },
        "extractedBy": { "type": "string" },
        "reviewed": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["effectiveFrom", "sourceTax", "pensionerExemptUpTo"],
        "properties": {
          "effectiveFrom": { "type": "string" },
          "effectiveTo": { "type": ["string", "null"] },
          "sourceTax": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["rate"],
              "properties": {
                "upToInvestment": { "type": "number" },
                "above": { "type": "number" },
                "rate": { "type": "number" },
                "appliesTo": { "type": "string" }
              }
            }
          },
          "pensionerExemptUpTo": { "type": "number" },
          "measuredOn": { "type": "string" },
          "tinRelatedAdjustments": { "type": ["string", "null"] },
          "notes": {
            "type": "object",
            "properties": {
              "bn": { "type": "string" },
              "en": { "type": "string" }
            }
          }
        }
      }
    }
  }
}
