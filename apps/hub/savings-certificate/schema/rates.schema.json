{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SavingsCertificateRates",
  "type": "object",
  "required": ["meta", "periodId", "effectiveFrom", "effectiveTo", "currency", "tierThreshold", "tierMode", "schemes"],
  "properties": {
    "meta": {
      "type": "object",
      "required": ["schemaVersion", "dataVersion", "lastVerified", "sources"],
      "properties": {
        "schemaVersion": { "type": "string" },
        "dataVersion": { "type": "string" },
        "lastVerified": { "type": "string" },
        "sources": { "type": "array", "minItems": 1 },
        "extractedBy": { "type": "string" },
        "reviewed": { "type": "boolean" },
        "notes": { "type": "string" }
      }
    },
    "periodId": { "type": "string" },
    "effectiveFrom": { "type": "string" },
    "effectiveTo": { "type": "string" },
    "currency": { "type": "string", "enum": ["BDT"] },
    "tierThreshold": { "type": "number" },
    "tierMode": { "type": "string", "enum": ["excess_only", "whole_amount"] },
    "schemes": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["rateAtOrBelowThreshold", "rateAboveThreshold"],
        "properties": {
          "rateAtOrBelowThreshold": { "type": "number" },
          "rateAboveThreshold": { "type": "number" },
          "payoutTablePerLakh": {
            "type": ["object", "null"],
            "properties": {
              "grossPerPayoutAtOrBelow": { "type": "number" },
              "grossPerPayoutAbove": { "type": "number" },
              "frequency": { "type": "string" },
              "atMaturityGrossTotalAtOrBelow": { "type": "number" },
              "atMaturityGrossTotalAbove": { "type": "number" }
            }
          },
          "earlyEncashment": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["afterFullYears"],
              "properties": {
                "afterFullYears": { "type": "number" },
                "rateAtOrBelowThreshold": { "type": ["number", "null"] },
                "rateAboveThreshold": { "type": ["number", "null"] }
              }
            }
          }
        }
      }
    }
  }
}
