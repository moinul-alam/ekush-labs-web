{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SavingsCertificateIndex",
  "type": "object",
  "required": [
    "meta",
    "latestPeriodId",
    "periods"
  ],
  "properties": {
    "meta": {
      "type": "object",
      "required": [
        "schemaVersion",
        "dataVersion",
        "lastVerified",
        "sources"
      ],
      "properties": {
        "schemaVersion": {
          "type": "string"
        },
        "dataVersion": {
          "type": "string"
        },
        "lastVerified": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "title",
              "url",
              "type"
            ],
            "properties": {
              "title": {
                "type": "string"
              },
              "url": {
                "type": "string"
              },
              "publishedOn": {
                "type": "string"
              },
              "type": {
                "enum": [
                  "gazette",
                  "circular",
                  "official-site",
                  "news"
                ]
              }
            }
          }
        },
        "extractedBy": {
          "type": "string"
        },
        "reviewed": {
          "type": "boolean"
        },
        "notes": {
          "type": "string"
        }
      }
    },
    "latestPeriodId": {
      "type": "string"
    },
    "periods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "from",
          "to",
          "file"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "from": {
            "type": "string"
          },
          "to": {
            "type": "string"
          },
          "file": {
            "type": "string"
          },
          "label": {
            "type": "object",
            "properties": {
              "bn": {
                "type": "string"
              },
              "en": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}