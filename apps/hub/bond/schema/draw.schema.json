{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrizeBondDraw",
  "type": "object",
  "required": ["schemaVersion", "id", "drawNumber", "date", "source", "tiers"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "id": { "type": "string", "pattern": "^[0-9]{3}$" },
    "drawNumber": { "type": "integer", "minimum": 1 },
    "date": { "type": "string", "format": "date" },
    "source": {
      "type": "object",
      "required": ["name", "url", "extractedAt"],
      "properties": {
        "name": { "type": "string" },
        "url": { "type": "string" },
        "pdf": { "type": "string" },
        "extractedAt": { "type": "string" }
      }
    },
    "tiers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["tier", "amount", "expectedCount", "numbers"],
        "properties": {
          "tier": { "type": "integer", "minimum": 1, "maximum": 5 },
          "amount": { "type": "number", "minimum": 0 },
          "expectedCount": { "type": "integer", "minimum": 1 },
          "numbers": {
            "type": "array",
            "items": { "type": "string", "pattern": "^[0-9]{7}$" }
          }
        }
      }
    }
  }
}
