{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PrizeBondIndexManifest",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "latestDraw", "draws"],
  "properties": {
    "schemaVersion": { "type": "integer", "enum": [1] },
    "generatedAt": { "type": "string" },
    "latestDraw": { "type": "integer" },
    "draws": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "drawNumber", "date", "file", "version", "totalWinners", "claimableUntil"],
        "properties": {
          "id": { "type": "string" },
          "drawNumber": { "type": "integer" },
          "date": { "type": "string" },
          "file": { "type": "string" },
          "version": { "type": "string" },
          "totalWinners": { "type": "integer" },
          "claimableUntil": { "type": "string" }
        }
      }
    }
  }
}
