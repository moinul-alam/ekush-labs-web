---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import BMICalculator from '../components/BMICalculator.svelte';
import PromoBanner from '../components/PromoBanner.astro';
import { getLangFromUrl, useTranslations } from '@ekush-labs/ui/src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={lang === 'bn' ? "বিএমআই ক্যালকুলেটর - একুশ টুলস" : "BMI Calculator - EkushLabs Tools"} appName="EkushTools" pageTitle={lang === 'bn' ? "বিএমআই ক্যালকুলেটর" : "BMI Calculator"}>
  <div class="pt-24 pb-12 px-[5vw]">
    <div class="max-w-4xl mx-auto">
      
      <BMICalculator client:load lang={lang} />

      <!-- Bottom CTA -->
      <PromoBanner />
    </div>
  </div>
</BaseLayout>
