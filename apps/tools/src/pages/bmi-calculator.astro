---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import BMICalculator from '../components/BMICalculator.svelte';
import { getLangFromUrl, useTranslations } from '@ekush-labs/ui/src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={lang === 'bn' ? "বিএমআই ক্যালকুলেটর - একুশ টুলস" : "BMI Calculator - EkushLabs Tools"} appName="EkushTools" pageTitle={lang === 'bn' ? "বিএমআই ক্যালকুলেটর" : "BMI Calculator"}>
  <div class="pt-24 pb-12 px-[5vw]">
    <div class="max-w-4xl mx-auto">
      
      <BMICalculator client:load lang={lang} />

      <!-- Bottom CTA -->
      <div class="mt-16 text-center py-10 px-6 bg-gradient-to-br from-purple-600/10 to-orange-400/10 rounded-3xl border border-slate-200 dark:border-slate-700">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">{t('tools.hero.shonamoni')}</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6 max-w-lg mx-auto">{lang === 'bn' ? "আপনার শিশুর বিকাশ পর্যবেক্ষণ করুন এবং বিশেষজ্ঞদের নির্দেশনা পান।" : "Monitor your child's development, track milestones, and get expert guidance."}</p>
        <a href="https://shonamoni.ekushlabs.com" class="inline-flex items-center gap-2 bg-gradient-to-r from-purple-600 to-orange-400 text-white px-8 py-3 rounded-full font-bold shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all">
          {lang === 'bn' ? "সোনামনি ডাউনলোড করুন" : "Get Shonamoni"}
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
