---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import UnitConverterComponent from '../components/UnitConverter.svelte';
import PromoBanner from '../components/PromoBanner.astro';
import { getLangFromUrl, useTranslations } from '@ekush-labs/ui/src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={lang === 'bn' ? "ইউনিট কনভার্টার - একুশ টুলস" : "Unit Converter - EkushLabs Tools"} appName="EkushTools" pageTitle={lang === 'bn' ? "ইউনিট কনভার্টার" : "Unit Converter"}>
  <div class="pt-24 pb-12 px-[5vw]">
    <div class="max-w-5xl mx-auto">
      
      <UnitConverterComponent client:load lang={lang} />

      <!-- Bottom CTA -->
      <PromoBanner />
    </div>
  </div>
</BaseLayout>
