---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import CalendarComponent from '../components/Calendar.svelte';
import PromoBanner from '../components/PromoBanner.astro';
import { getLangFromUrl, useTranslations } from '@ekush-labs/ui/src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={lang === 'bn' ? "বাংলা ক্যালেন্ডার - একুশ টুলস" : "Bangla Calendar - EkushLabs Tools"} appName="EkushTools" pageTitle={lang === 'bn' ? "বাংলা ক্যালেন্ডার" : "Bangla Calendar"}>
  <div class="pt-16 md:pt-24 pb-12 px-[5vw]">
    <div class="max-w-6xl mx-auto">
      
      <CalendarComponent client:load lang={lang} />

      <!-- Bottom CTA -->
      <PromoBanner />
    </div>
  </div>
</BaseLayout>
