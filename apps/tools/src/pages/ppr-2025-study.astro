---
import BaseLayout from "@ekush-labs/ui/src/layouts/BaseLayout.astro";
import StudyApp from "../components/ppr/StudyApp.svelte";
import PromoBanner from "../components/PromoBanner.astro";
import { useTranslations } from "@ekush-labs/ui/src/i18n/utils";

const t = useTranslations("bn");

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: [
    {
      "@type": "Question",
      name: "সরকারি ক্রয় বিধিমালা ২০২৫-এর বিধি কীভাবে খুঁজে পাব?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "অনুসন্ধান বাক্সে বিধির নম্বর (যেমন ৪২), বিষয় (যেমন কোটেশন) বা পরিচিত সংক্ষিপ্ত রূপ (যেমন OTM) লিখুন। ফলাফল অধ্যায়ভিত্তিকভাবে সাজানো হয় এবং প্রতিটি সারিতে গেজেট পৃষ্ঠা দেখানো হয়।",
      },
    },
    {
      "@type": "Question",
      name: "এক বিধি অন্য কোন বিধি নির্দেশ করে তা কি দেখা যায়?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "হ্যাঁ। প্রতিটি বিধির বিধান-পাঠে উল্লেখিত 'বিধি', 'তফসিল' ও 'অধ্যায়' ক্লিকযোগ্য সংযোগ হিসেবে দেখানো হয় এবং 'যেসব বিধি নির্দেশ করে' ও 'যেখানে এই বিধি টানা হয়েছে' তালিকা দিয়ে উভয় দিকের সম্পর্ক পাওয়া যায়।",
      },
    },
    {
      "@type": "Question",
      name: "মূল গেজেটের যে পৃষ্ঠায় বিধিটি আছে তা কি খোলা যায়?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "হ্যাঁ। প্রতিটি বিধির সাথে পৃষ্ঠা নম্বর দেওয়া থাকে এবং ক্লিক করলে স্বয়ংক্রিয়ভাবে সেই পৃষ্ঠা থেকে মূল পিডিএফ (pdf.js) খুলে যায়। পৃষ্ঠা নম্বর অনুমান নয় — প্রতিটি গেজেট পৃষ্ঠার মুদ্রিত ফুটার যাচাই করা হয়েছে।",
      },
    },
    {
      "@type": "Question",
      name: "এই পাঠ কি সরকারি গেজেটের বদলে ব্যবহার করা যাবে?",
      acceptedAnswer: {
        "@type": "Answer",
        text: "না। এটি মূল গেজেটের অনানুষ্ঠানিক পাঠ-সহায়ক। তথ্য যাচাইয়ের জন্য সর্বদা বাংলাদেশ গেজেটে প্রকাশিত মূল বিধিমালা দেখুন।",
      },
    },
  ],
};
---

<BaseLayout
  title={`${t("tools.ppr.title")} | ${t("app.ekushlabs")}`}
  description={t("tools.ppr.desc")}
  appName="EkushTools"
  pageTitle={t("tools.ppr.title")}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="pt-24 pb-16 px-[5vw] min-h-screen relative">
    <!-- Background Ambient Decor -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
      <div
        class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full bg-gradient-to-b from-emerald-500/10 to-transparent blur-3xl"
      >
      </div>
      <div
        class="absolute bottom-0 left-1/4 w-[600px] h-[600px] rounded-full bg-gradient-to-t from-indigo-500/10 to-transparent blur-3xl"
      >
      </div>
    </div>

    <!-- SEO & Intro Heading Shell -->
    <div class="max-w-4xl mx-auto text-center mb-10">
      <span
        class="inline-flex items-center gap-1.5 px-3.5 py-1.5 rounded-full bg-emerald-500/10 text-emerald-700 dark:text-emerald-400 text-xs font-bold uppercase tracking-wider mb-4 border border-emerald-500/20"
      >
        🇧🇩 {t("tools.ppr.badge")}
      </span>
      <h1
        class="text-3xl sm:text-4xl md:text-5xl font-black tracking-tight leading-[1.25] md:leading-[1.2] mb-4 text-slate-900 dark:text-white"
      >
        <span
          class="bg-gradient-to-r from-emerald-600 via-teal-600 to-primary-start dark:from-emerald-400 dark:via-teal-300 dark:to-blue-400 bg-clip-text text-transparent"
        >
          {t("tools.ppr.subtitle")}
        </span>
      </h1>
    </div>

    <!-- Interactive Island -->
    <StudyApp client:load lang="bn" />

    <div class="max-w-4xl mx-auto mt-12">
      <PromoBanner />
    </div>
  </div>
</BaseLayout>
