---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import PercentageCalculatorComponent from '../../components/PercentageCalculator.svelte';
import PromoBanner from '../../components/PromoBanner.astro';
import { useTranslations } from '@ekush-labs/ui/src/i18n/utils';

const t = useTranslations('en');
---

<BaseLayout title="Percentage Calculator - EkushLabs Tools" appName="EkushTools" pageTitle="Percentage Calculator">
  <div class="pt-24 pb-12 px-[5vw]">
    <div class="max-w-5xl mx-auto">
      
      <PercentageCalculatorComponent client:load lang="en" />

      <!-- Bottom CTA -->
      <PromoBanner />
    </div>
  </div>
</BaseLayout>
