---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import Calendar from '../../components/Calendar.svelte';
---

<BaseLayout title="Bangla Calendar - EkushLabs Tools" appName="EkushTools" pageTitle="Bangla Calendar">
  <div class="pt-24 pb-12 px-[5vw]">
    <div class="max-w-6xl mx-auto">
      
      <Calendar client:load />

      <!-- Bottom CTA -->
      <div class="mt-16 text-center py-10 px-6 bg-gradient-to-br from-emerald-600/10 to-teal-400/10 rounded-3xl border border-slate-200 dark:border-slate-700">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">Get the Ekush Ponji App</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6 max-w-lg mx-auto">Calendar, Holidays, Events, Reminders, Age Calculator, Daily Quote and more.</p>
        <a href="https://ponji.ekushlabs.com" class="inline-flex items-center gap-2 bg-gradient-to-r from-emerald-600 to-teal-500 text-white px-8 py-3 rounded-full font-bold shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all">
          Get Ekush Ponji
          <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
