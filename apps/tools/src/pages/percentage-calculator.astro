---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import PercentageCalculatorComponent from '../components/PercentageCalculator.svelte';
import PromoBanner from '../components/PromoBanner.astro';
import { getLangFromUrl, useTranslations } from '@ekush-labs/ui/src/i18n/utils';
---

<BaseLayout title="শতাংশ ক্যালকুলেটর - একুশ টুলস" appName="EkushTools" pageTitle="শতাংশ ক্যালকুলেটর">
  <div class="pt-24 pb-12 px-[5vw]">
    <div class="max-w-5xl mx-auto">
      
      <PercentageCalculatorComponent client:load lang="bn" />

      <!-- Bottom CTA -->
      <PromoBanner />
    </div>
  </div>
</BaseLayout>
