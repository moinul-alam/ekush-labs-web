---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import AgeCalculatorComponent from '../components/AgeCalculator.svelte';
import PromoBanner from '../components/PromoBanner.astro';
import { getLangFromUrl, useTranslations } from '@ekush-labs/ui/src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={lang === 'bn' ? "বয়স ক্যালকুলেটর - একুশ টুলস" : "Age Calculator - EkushLabs Tools"} appName="EkushTools" pageTitle={lang === 'bn' ? "বয়স ক্যালকুলেটর" : "Age Calculator"}>
  <div class="pt-24 pb-12 px-[5vw]">
    <div class="max-w-5xl mx-auto">
      
      <AgeCalculatorComponent client:load lang={lang} />

      <!-- Bottom CTA -->
      <PromoBanner />
    </div>
  </div>
</BaseLayout>
