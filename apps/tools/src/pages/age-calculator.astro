---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import AgeCalculatorComponent from '../components/AgeCalculator.svelte';
import { getLangFromUrl, useTranslations } from '@ekush-labs/ui/src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout title={lang === 'bn' ? "বয়স ক্যালকুলেটর - একুশ টুলস" : "Age Calculator - EkushLabs Tools"} appName="EkushTools" pageTitle={lang === 'bn' ? "বয়স ক্যালকুলেটর" : "Age Calculator"}>
  <div class="pt-24 pb-12 px-[5vw]">
    <div class="max-w-5xl mx-auto">
      
      <AgeCalculatorComponent client:load lang={lang} />

      <!-- Bottom CTA -->
      <div class="mt-16 text-center py-10 px-6 bg-gradient-to-br from-blue-600/10 to-cyan-400/10 rounded-3xl border border-slate-200 dark:border-slate-700">
        <h2 class="text-2xl font-bold text-slate-900 dark:text-white mb-3">{t('tools.hero.ponji')}</h2>
        <p class="text-slate-600 dark:text-slate-400 mb-6 max-w-lg mx-auto">{lang === 'bn' ? "ক্যালেন্ডার, ছুটির দিন, ইভেন্ট, রিমাইন্ডার, বয়স ক্যালকুলেটর, প্রতিদিনের উক্তি এবং আরও অনেক কিছু।" : "Calendar, Holidays, Events, Reminders, Age Calculator, Daily Quote and more."}</p>
        <a href="https://ponji.ekushlabs.com" class="inline-flex items-center gap-2 bg-gradient-to-r from-blue-600 to-cyan-500 text-white px-8 py-3 rounded-full font-bold shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all">
          {lang === 'bn' ? "একুশ পঞ্জি ডাউনলোড করুন" : "Get Ekush Ponji"}
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 512 512">
            <path d="M325.3 234.3L104.6 13l280.8 161.2-60.1 60.1zM47 0C34 6.8 25.3 19.2 25.3 35.3v441.3c0 16.1 8.7 28.5 21.7 35.3l256.6-256L47 0zm425.2 225.6l-58.9-34.1-65.7 64.5 65.7 64.5 60.1-34.1c18-14.3 18-46.5-1.2-60.8zM104.6 499l280.8-161.2-60.1-60.1L104.6 499z" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</BaseLayout>
