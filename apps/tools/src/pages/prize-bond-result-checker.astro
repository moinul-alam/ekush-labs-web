---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import Checker from '../components/prize-bond/Checker.svelte';
import PromoBanner from '../components/PromoBanner.astro';
import { useTranslations } from '@ekush-labs/ui/src/i18n/utils';

const t = useTranslations('bn');

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    {
      "@type": "Question",
      "name": "প্রাইজবন্ডের ড্র কত দিন পর পর অনুষ্ঠিত হয়?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "বাংলাদেশ ব্যাংকের অধীনে প্রাইজবন্ড ড্র বছরে চারবার অনুষ্ঠিত হয় — ৩১ জানুয়ারি, ৩০ এপ্রিল, ৩১ জুলাই এবং ৩১ অক্টোবর।"
      }
    },
    {
      "@type": "Question",
      "name": "সিরিজের অক্ষর বা বর্ণ কি ফলাফলে প্রভাব ফেলে?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "না। বাংলাদেশ ব্যাংকের নিয়মানুযায়ী ফলাফল ড্র অনুষ্ঠিত হয় কেবল ৭-সংখ্যার নম্বরের উপর। সকল সিরিজের একই নম্বরের বন্ড পুরস্কৃত হয়।"
      }
    },
    {
      "@type": "Question",
      "name": "পুরস্কার দাবির মেয়াদ কত দিন?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "ড্র অনুষ্ঠানের তারিখ হতে পরবর্তী ২ (দুই) বছর পর্যন্ত পুরস্কার দাবি করা যায়।"
      }
    }
  ]
};
---

<BaseLayout
  title={`${t('tools.prizebond.title')} | ${t('app.ekushlabs')}`}
  description={t('tools.prizebond.desc')}
  appName="EkushTools"
  pageTitle={t('tools.prizebond.title')}
>
  <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

  <div class="pt-24 pb-16 px-[5vw] min-h-screen relative">
    <!-- Background Decor -->
    <div class="absolute inset-0 overflow-hidden pointer-events-none -z-10">
      <div class="absolute top-0 right-1/4 w-[500px] h-[500px] rounded-full bg-gradient-to-b from-blue-500/10 to-transparent blur-3xl"></div>
      <div class="absolute bottom-0 left-1/4 w-[600px] h-[600px] rounded-full bg-gradient-to-t from-emerald-500/10 to-transparent blur-3xl"></div>
    </div>

    <!-- SEO & Intro Heading Shell -->
    <div class="max-w-4xl mx-auto text-center mb-10">
      <!-- Authentic Live Badge -->
      <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-emerald-500/10 dark:bg-emerald-400/10 border border-emerald-500/20 text-emerald-700 dark:text-emerald-300 text-xs sm:text-sm font-semibold mb-4 backdrop-blur-sm shadow-xs transition-transform hover:scale-105">
        <span class="relative flex h-2 w-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
        </span>
        <span>বাংলাদেশ প্রাইজ বন্ড (১০০ টাকা মূল্যমান)</span>
      </div>

      <!-- Main Focus Hero Heading (H1 for SEO & Visual Impact) -->
      <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-black tracking-tight leading-[1.25] md:leading-[1.2] mb-4 text-slate-900 dark:text-white">
        <span class="bg-gradient-to-r from-emerald-600 via-teal-600 to-primary-start dark:from-emerald-400 dark:via-teal-300 dark:to-blue-400 bg-clip-text text-transparent">
          {t('tools.prizebond.subtitle')}
        </span>
      </h1>

      <!-- Supporting Tagline -->

      <!-- Trust & Key Feature Badges -->
      <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 text-xs sm:text-sm font-medium text-slate-700 dark:text-slate-200">
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs backdrop-blur-sm">
          <span class="text-base">⚡</span>
          <span>এক ক্লিকে নির্ভুল যাচাই</span>
        </div>
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs backdrop-blur-sm">
          <span class="text-base">🔒</span>
          <span>১০০% নিরাপদ ও ক্লায়েন্ট-সাইড</span>
        </div>
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs backdrop-blur-sm">
          <span class="text-base">📄</span>
          <span>ফ্রি PDF রিপোর্ট</span>
        </div>
        <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-xl bg-white/80 dark:bg-slate-800/80 border border-slate-200/80 dark:border-slate-700/60 shadow-xs backdrop-blur-sm">
          <span class="text-base">📅</span>
          <span>বিগত ২ বছরের সকল ড্র</span>
        </div>
      </div>
    </div>

    <!-- Interactive Island -->
    <Checker client:load lang="bn" />

    <div class="max-w-4xl mx-auto mt-12">
      <PromoBanner />
    </div>
  </div>
</BaseLayout>