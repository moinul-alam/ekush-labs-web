---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import { useTranslations, getLangFromUrl } from '@ekush-labs/ui/src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout 
  title="Ekush Ponji - Your complete Bengali calendar companion" 
  description="Ekush Ponji is a Bengali calendar app with events, reminders, daily quotes, daily words, date calculator and more — built for everyday life in Bangladesh."
  appName="Ekush Ponji"
  navLinks={[
    { name: t('ponji.stats.features'), href: '#features' },
    { name: t('ponji.screenshots.title_prefix'), href: '#screenshots' },
    { name: t('ponji.support.title'), href: '#support' }
  ]}
>
  <!-- Hero Section -->
  <section id="hero" class="relative pt-32 pb-24 px-[5vw] overflow-hidden min-h-screen flex flex-col lg:flex-row items-center gap-16 max-w-7xl mx-auto">
    <!-- Background glows -->
    <div class="absolute top-[20%] left-[10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[radial-gradient(circle,rgba(16,185,129,0.15)_0%,transparent_70%)] rounded-full blur-[80px] -z-10 animate-[pulse_8s_ease-in-out_infinite]"></div>
    
    <div class="flex-1 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-emerald-50 dark:bg-emerald-500/10 border border-emerald-200 dark:border-emerald-500/20 text-sm font-bold text-emerald-700 dark:text-emerald-400 mb-8 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
        {t('ponji.hero.badge')}
      </div>
      
      <h1 class="font-display text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.9] tracking-tight text-slate-900 dark:text-white mb-8">
        {t('ponji.hero.title1')}<br/>
        <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent drop-shadow-sm">{t('ponji.hero.title_highlight')}</span><br/>
        {t('ponji.hero.title2')}
      </h1>
      
      <p class="text-xl text-slate-600 dark:text-silver max-w-[500px] mb-12 leading-relaxed">{t('ponji.hero.desc')}</p>
      
      <div class="flex flex-wrap items-center gap-6 mb-16">
        <a href="https://play.google.com/store/apps/details?id=com.ekushlabs.ponji" class="group relative flex items-center gap-3 px-8 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold rounded-full overflow-hidden shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-400">
          <div class="absolute inset-0 bg-gradient-to-r from-emerald-500 to-teal-500 opacity-0 group-hover:opacity-100 transition-opacity duration-400"></div>
          <svg class="w-6 h-6 relative z-10 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.357zm.014 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.37z"/>
          </svg>
          <span class="relative z-10 group-hover:text-white transition-colors flex flex-col items-start leading-none">
            <span class="text-[0.65rem] uppercase tracking-wider opacity-80">{t('ponji.hero.get_on')}</span>
            <span class="text-base">Google Play</span>
          </span>
        </a>
        
        <a href="#features" class="flex items-center gap-2 font-bold text-slate-700 dark:text-white hover:text-emerald-500 dark:hover:text-emerald-400 transition-colors">
          {t('ponji.hero.explore')}
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
        </a>
      </div>

      <div class="flex items-center gap-8 md:gap-12 text-center">
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">2</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">{t('ponji.stats.languages')}</div>
        </div>
        <div class="w-px h-12 bg-slate-200 dark:bg-white/10"></div>
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">9+</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">{t('ponji.stats.features')}</div>
        </div>
        <div class="w-px h-12 bg-slate-200 dark:bg-white/10"></div>
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">100%</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">{t('ponji.stats.offline')}</div>
        </div>
      </div>
    </div>

    <!-- Hero Phone Mockup (Perfect Replica) -->
    <div class="flex-1 flex justify-center lg:justify-end reveal reveal-delay-2 perspective-[1000px]">
      <div class="phone-mockup-hero transform rotate-y-[0deg] rotate-x-[0deg] transition-transform duration-700 hover:-translate-y-2">
        <div class="phone-screen-hero">
          <img src="https://ekushponji.ekushlabs.com/assets/screenshots/1_home.png" alt="Ekush Ponji Home Screen" onerror="this.src='/assets/screenshots/1_home.png'" />
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-32 px-[5vw] relative z-10 bg-slate-50/50 dark:bg-black/20 border-y border-slate-200/50 dark:border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-24 reveal">
        <p class="text-sm font-bold tracking-widest uppercase text-emerald-500 mb-3">{t('ponji.features.title_prefix')}</p>
        <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white">
          {t('ponji.features.title1')}<br/>
          <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent">{t('ponji.features.title_highlight')}</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { icon: 'calendar', title: t('ponji.features.multi_calendar'), desc: t('ponji.features.multi_calendar_desc') },
          { icon: 'gov', title: t('ponji.features.holidays'), desc: t('ponji.features.holidays_desc') },
          { icon: 'bell', title: t('ponji.features.reminders'), desc: t('ponji.features.reminders_desc') },
          { icon: 'quote', title: t('ponji.features.quotes'), desc: t('ponji.features.quotes_desc') },
          { icon: 'book-open', title: t('ponji.features.words'), desc: t('ponji.features.words_desc') },
          { icon: 'calculator', title: t('ponji.features.calculator'), desc: t('ponji.features.calculator_desc') },
          { icon: 'moon', title: t('ponji.features.theme'), desc: t('ponji.features.theme_desc') },
          { icon: 'book', title: t('ponji.features.bilingual'), desc: t('ponji.features.bilingual_desc') },
          { icon: 'offline', title: t('ponji.features.offline_title'), desc: t('ponji.features.offline_desc') }
        ].map((f, i) => (
          <div class={`p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-500 reveal reveal-delay-${i % 3}`}>
            <div class="w-14 h-14 rounded-2xl bg-emerald-50 dark:bg-black/50 border border-emerald-100 dark:border-white/10 flex items-center justify-center mb-6">
              {f.icon === 'calendar' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>}
              {f.icon === 'gov' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M4 15s1-1 4-1 5 2 8 2 4-1 4-1V3s-1 1-4 1-5-2-8-2-4 1-4 1z"></path><line x1="4" y1="22" x2="4" y2="15"></line></svg>}
              {f.icon === 'bell' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"></path><path d="M13.73 21a2 2 0 0 1-3.46 0"></path></svg>}
              {f.icon === 'quote' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>}
              {f.icon === 'book-open' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"></path><path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"></path></svg>}
              {f.icon === 'calculator' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M12 8v4l3 3"></path></svg>}
              {f.icon === 'moon' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><circle cx="12" cy="12" r="3"></circle><path d="M12 1v4M12 19v4M4.22 4.22l2.83 2.83M16.95 16.95l2.83 2.83M1 12h4M19 12h4M4.22 19.78l2.83-2.83M16.95 7.05l2.83-2.83"></path></svg>}
              {f.icon === 'book' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"></path><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"></path></svg>}
              {f.icon === 'offline' && <svg class="w-6 h-6 text-emerald-500" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07A19.5 19.5 0 0 1 4.69 12a19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 3.6 1.27h3a2 2 0 0 1 2 1.72c.127.96.361 1.903.7 2.81a2 2 0 0 1-.45 2.11L7.91 8.96a16 16 0 0 0 6 6l.92-.92a2 2 0 0 1 2.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0 1 21.73 16.92z"></path></svg>}
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{f.title}</h3>
            <p class="text-slate-600 dark:text-silver leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Screenshots Carousel Section -->
  <section id="screenshots" class="py-32 px-[5vw] relative z-10 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-24 reveal">
        <p class="text-sm font-bold tracking-widest uppercase text-emerald-500 mb-3">{t('ponji.screenshots.title_prefix')}</p>
        <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white">
          {t('ponji.screenshots.title1')}<br/>
          <span class="bg-gradient-to-r from-emerald-500 to-teal-400 bg-clip-text text-transparent">{t('ponji.screenshots.title_highlight')}</span>
        </h2>
      </div>

      <!-- Horizontal scrolling container -->
      <div class="flex gap-8 overflow-x-auto pb-16 snap-x snap-mandatory hide-scrollbar">
        {[
          { img: '2_calendar.png', title: 'Full Calendar View', desc: 'Holidays highlighted, dual dates shown' },
          { img: '3_all_holidays.png', title: 'Full Calendar View', desc: 'Holidays highlighted, dual dates shown' },
          { img: '4_daily_words.png', title: 'Daily Inspiration', desc: 'Discover a new word every day' },
          { img: '5_calculator.png', title: 'Date Calculator', desc: 'Calculate age or days between any two dates' }
        ].map((s, i) => (
          <div class={`min-w-[280px] md:min-w-[320px] flex-col items-center text-center snap-center reveal reveal-delay-${i}`}>
            <!-- Perfect Replica Phone Mockup -->
            <div class="screenshot-phone transition-transform hover:-translate-y-2 duration-500 mb-8 mx-auto">
              <div class="screenshot-phone-inner">
                <img src={`https://ekushponji.ekushlabs.com/assets/screenshots/${s.img}`} alt={s.title} onerror={`this.src='/assets/screenshots/${s.img}'`} />
              </div>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{s.title}</h3>
            <p class="text-slate-600 dark:text-silver max-w-[220px] mx-auto">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Support Section -->
  <section id="support" class="py-32 px-[5vw] relative z-10 bg-gradient-to-b from-slate-50 to-slate-100 dark:from-black/10 dark:to-black/40 border-t border-slate-200/50 dark:border-white/5">
    <div class="max-w-3xl mx-auto text-center reveal">
      <div class="w-20 h-20 bg-emerald-100 dark:bg-emerald-900/30 rounded-full flex items-center justify-center mx-auto mb-8">
        <svg class="w-10 h-10 text-emerald-600 dark:text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
      </div>
      <p class="text-sm font-bold tracking-widest uppercase text-emerald-500 mb-3">{t('ponji.support.title_prefix')}</p>
      <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-6">{t('ponji.support.title')}</h2>
      <p class="text-xl text-slate-600 dark:text-silver mb-10">{t('ponji.support.desc')}</p>
      
      <a href="mailto:ekushlabs@gmail.com" class="inline-flex items-center gap-3 px-10 py-5 bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] rounded-full text-slate-800 dark:text-white font-bold text-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-400">
        <svg class="w-5 h-5 text-emerald-500" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z" />
          <polyline points="22,6 12,13 2,6" />
        </svg>
        ekushlabs@gmail.com
      </a>
    </div>
  </section>

  <!-- Legal Links -->
  <section class="py-12 px-[5vw] relative z-10 text-center border-t border-slate-200/50 dark:border-white/5 bg-slate-50 dark:bg-transparent">
    <div class="flex flex-wrap justify-center gap-6 text-sm font-semibold">
      <a href="/privacy" class="text-slate-500 hover:text-slate-800 dark:text-silver dark:hover:text-white transition-colors">{t('ponji.privacy')}</a>
      <a href="/terms" class="text-slate-500 hover:text-slate-800 dark:text-silver dark:hover:text-white transition-colors">{t('ponji.terms')}</a>
    </div>
  </section>

  <style>
    /* Phone mockup hero */
    .phone-mockup-hero {
      width: 260px;
      height: 576px;
      background: var(--text-primary, #0D1F1A);
      border-radius: 30px;
      padding: 6px;
      box-shadow: 0 24px 64px rgba(0, 107, 84, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.1);
      position: relative;
    }

    :global(html[data-theme='dark']) .phone-mockup-hero {
      background: #0f172a;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .phone-mockup-hero::before {
      content: '';
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 6px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 100px;
      z-index: 2;
    }

    .phone-screen-hero {
      width: 100%;
      height: 100%;
      background: var(--surface, #F4F9F7);
      border-radius: 24px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .phone-screen-hero img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Screenshot phone */
    .screenshot-phone {
      width: 200px;
      height: 432px;
      background: var(--text-primary, #0D1F1A);
      border-radius: 32px;
      padding: 10px;
      box-shadow: 0 24px 64px rgba(0, 107, 84, 0.16), 0 0 0 1px rgba(0, 0, 0, 0.08);
      position: relative;
      flex-shrink: 0;
    }

    :global(html[data-theme='dark']) .screenshot-phone {
      background: #0f172a;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .screenshot-phone::before {
      content: '';
      position: absolute;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 5px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 100px;
      z-index: 2;
    }

    .screenshot-phone-inner {
      width: 100%;
      height: 100%;
      border-radius: 24px;
      overflow: hidden;
      background: var(--surface, #F4F9F7);
    }

    .screenshot-phone-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      display: block;
    }

    /* Animations */
    .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-0 { transition-delay: 0ms; }
    .reveal-delay-1 { transition-delay: 150ms; }
    .reveal-delay-2 { transition-delay: 300ms; }
    
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script>
    function initReveal() {
      const observer = new IntersectionObserver((entries) => { 
        entries.forEach(entry => { 
          if (entry.isIntersecting) { 
            entry.target.classList.add('visible'); 
            observer.unobserve(entry.target); 
          } 
        }); 
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
    }
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  </script>
</BaseLayout>
