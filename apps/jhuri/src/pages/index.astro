---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
---

<BaseLayout 
  title="Jhuri - Smart Grocery List" 
  description="Jhuri is a smart grocery list app for Bangladesh. Browse 200+ items by category, plan your bazar, and shop with confidence — in Bangla."
  appName="Jhuri"
  navLinks={[
    { name: 'What\'s inside', href: '#categories' },
    { name: 'Features', href: '#features' },
    { name: 'Screenshots', href: '#screenshots' }
  ]}
>
  <!-- Hero Section -->
  <section id="hero" class="relative pt-32 pb-24 px-[5vw] overflow-hidden min-h-screen flex flex-col lg:flex-row items-center gap-16 max-w-7xl mx-auto">
    <!-- Background glows (Jhuri theme: Indigo/Blue) -->
    <div class="absolute top-[20%] right-[10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[radial-gradient(circle,rgba(79,70,229,0.15)_0%,transparent_70%)] rounded-full blur-[80px] -z-10 animate-[pulse_8s_ease-in-out_infinite]"></div>
    
    <div class="flex-1 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-indigo-50 dark:bg-indigo-500/10 border border-indigo-200 dark:border-indigo-500/20 text-sm font-bold text-indigo-700 dark:text-indigo-400 mb-8 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-indigo-500 animate-pulse"></span>
        Available on Android
      </div>
      
      <h1 class="font-display text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.9] tracking-tight text-slate-900 dark:text-white mb-8">
        Plan Better,<br/>
        <span class="bg-gradient-to-r from-indigo-500 to-blue-400 bg-clip-text text-transparent drop-shadow-sm">Shop Smarter.</span>
      </h1>
      
      <p class="text-xl text-slate-600 dark:text-silver max-w-[500px] mb-12 leading-relaxed">Jhuri brings 200+ grocery items organized by category, so you can plan your entire bazar in under 20 seconds — without typing a single word.</p>
      
      <div class="flex flex-wrap items-center gap-6 mb-16">
        <a href="https://play.google.com/store/apps/details?id=com.ekushlabs.jhuri" class="group relative flex items-center gap-3 px-8 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold rounded-full overflow-hidden shadow-lg hover:shadow-xl hover:-translate-y-1 transition-all duration-400">
          <div class="absolute inset-0 bg-gradient-to-r from-indigo-500 to-blue-500 opacity-0 group-hover:opacity-100 transition-opacity duration-400"></div>
          <svg class="w-6 h-6 relative z-10 group-hover:text-white transition-colors" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.357zm.014 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.37z"/>
          </svg>
          <span class="relative z-10 group-hover:text-white transition-colors flex flex-col items-start leading-none">
            <span class="text-[0.65rem] uppercase tracking-wider opacity-80">Get it on</span>
            <span class="text-base">Google Play</span>
          </span>
        </a>
        
        <a href="#features" class="flex items-center gap-2 font-bold text-slate-700 dark:text-white hover:text-indigo-500 dark:hover:text-indigo-400 transition-colors">
          See features
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
        </a>
      </div>

      <div class="flex items-center gap-8 md:gap-12 text-center">
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">200+</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">Grocery Items</div>
        </div>
        <div class="w-px h-12 bg-slate-200 dark:bg-white/10"></div>
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">8</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">Categories</div>
        </div>
        <div class="w-px h-12 bg-slate-200 dark:bg-white/10"></div>
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">20s</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">To Plan a Bazar</div>
        </div>
      </div>
    </div>

    <!-- Hero Phone Mockup -->
    <div class="flex-1 flex justify-center lg:justify-center relative reveal reveal-delay-2 perspective-[1000px]">
      <div class="phone-mockup-hero transform rotate-y-[0deg] rotate-x-[0deg] transition-transform duration-700 hover:-translate-y-2">
        <div class="phone-screen-hero">
          <img src="https://jhuri.ekushlabs.com/assets/screenshots/1_home.png" alt="Jhuri Home Screen" onerror="this.src='/assets/screenshots/1_home.png'" />
        </div>
      </div>
      
      <!-- Floating Elements -->
      <div class="absolute -left-8 top-1/4 bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-xl flex items-center gap-3 animate-[float_6s_ease-in-out_infinite]">
        <span class="text-2xl">🥬</span>
        <div>
          <div class="font-bold text-slate-900 dark:text-white text-sm">শাকসবজি</div>
          <div class="text-xs text-slate-500">35+ items</div>
        </div>
      </div>
      
      <div class="absolute -right-8 bottom-1/4 bg-white dark:bg-slate-800 p-4 rounded-2xl shadow-xl flex items-center gap-3 animate-[float_7s_ease-in-out_infinite_reverse]">
        <span class="text-2xl">🐟</span>
        <div>
          <div class="font-bold text-slate-900 dark:text-white text-sm">মাছ ও মাংস</div>
          <div class="text-xs text-slate-500">25+ items</div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Promise Strip -->
  <section class="py-8 bg-indigo-600 dark:bg-indigo-900 text-white overflow-hidden">
    <div class="max-w-7xl mx-auto px-[5vw]">
      <div class="flex flex-wrap justify-center md:justify-between items-center gap-8 text-sm md:text-base font-bold tracking-wide">
        <div class="flex items-center gap-2"><span class="text-xl">⚡</span> Ready in 20 seconds</div>
        <div class="hidden md:block w-1.5 h-1.5 rounded-full bg-white/30"></div>
        <div class="flex items-center gap-2"><span class="text-xl">📵</span> Works offline</div>
        <div class="hidden md:block w-1.5 h-1.5 rounded-full bg-white/30"></div>
        <div class="flex items-center gap-2"><span class="text-xl">🇧🇩</span> Built for Bangladesh</div>
        <div class="hidden md:block w-1.5 h-1.5 rounded-full bg-white/30"></div>
        <div class="flex items-center gap-2"><span class="text-xl">🔒</span> No data collected</div>
      </div>
    </div>
  </section>

  <!-- Categories Section -->
  <section id="categories" class="py-32 px-[5vw] relative z-10 bg-slate-50/50 dark:bg-black/20">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-24 reveal">
        <p class="text-sm font-bold tracking-widest uppercase text-indigo-500 mb-3">What's inside</p>
        <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white mb-6">
          8 categories,<br/>
          <span class="bg-gradient-to-r from-indigo-500 to-blue-400 bg-clip-text text-transparent">everything you need.</span>
        </h2>
        <p class="text-xl text-slate-600 dark:text-silver max-w-2xl mx-auto">Every item your household buys regularly, organized exactly how you think about them.</p>
      </div>

      <div class="grid grid-cols-2 md:grid-cols-4 gap-6">
        {[
          { emoji: '🥬', bn: 'শাকসবজি', en: 'Vegetables', count: '35+ items' },
          { emoji: '🐟', bn: 'মাছ ও মাংস', en: 'Fish & Meat', count: '25+ items' },
          { emoji: '🌾', bn: 'চাল, ডাল ও মশলা', en: 'Rice, Lentils & Spices', count: '40+ items' },
          { emoji: '🥛', bn: 'তেল ও দুগ্ধজাত', en: 'Oil & Dairy', count: '20+ items' },
          { emoji: '🍎', bn: 'ফলমূল', en: 'Fruits', count: '25+ items' },
          { emoji: '🍚', bn: 'খাদ্যসামগ্রী', en: 'Food Essentials', count: '20+ items' },
          { emoji: '🧼', bn: 'পরিচ্ছন্নতা সামগ্রী', en: 'Cleaning & Personal Care', count: '15+ items' },
          { emoji: '🧹', bn: 'গৃহস্থালি সামগ্রী', en: 'Household Items', count: '30+ items' }
        ].map((c, i) => (
          <div class={`p-8 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] text-center hover:shadow-lg hover:-translate-y-2 transition-all duration-300 reveal reveal-delay-${i % 4}`}>
            <div class="text-4xl mb-4">{c.emoji}</div>
            <h3 class="text-lg font-bold text-slate-900 dark:text-white mb-1">{c.bn}</h3>
            <p class="text-xs text-slate-500 dark:text-silver mb-3">{c.en}</p>
            <div class="inline-block px-3 py-1 bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 text-xs font-bold rounded-full">{c.count}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Features Bento Box -->
  <section id="features" class="py-32 px-[5vw] relative z-10 border-t border-slate-200/50 dark:border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="mb-16 reveal">
        <p class="text-sm font-bold tracking-widest uppercase text-indigo-500 mb-3">Features</p>
        <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white">
          Everything for your<br/>
          <span class="bg-gradient-to-r from-indigo-500 to-blue-400 bg-clip-text text-transparent">weekly bazar.</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 auto-rows-[auto]">
        {/* Row 1 */}
        <div class="md:col-span-2 p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl transition-all duration-300 reveal flex flex-col justify-between">
          <div>
            <div class="text-4xl mb-6">🛒</div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Smart Item Browser</h3>
            <p class="text-slate-600 dark:text-silver text-lg leading-relaxed">Browse 200+ pre-loaded grocery items across 8 categories. Tap to add — no typing required. Adjust quantity, unit, and price before adding to your list.</p>
          </div>
          <div class="mt-8 self-start px-4 py-1.5 bg-indigo-100 dark:bg-indigo-900/50 text-indigo-700 dark:text-indigo-300 text-sm font-bold rounded-full">Core feature</div>
        </div>

        <div class="p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl transition-all duration-300 reveal">
          <div class="text-4xl mb-6">✅</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Shopping Mode</h3>
          <p class="text-slate-600 dark:text-silver leading-relaxed">A focused checklist view for the actual bazar. Checked items move to the bottom.</p>
        </div>

        {/* Row 2 */}
        <div class="p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl transition-all duration-300 reveal">
          <div class="text-4xl mb-6">🎉</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Celebration on Completion</h3>
          <p class="text-slate-600 dark:text-silver leading-relaxed">When you mark everything bought, confetti bursts across the screen. Small joy, big motivation.</p>
        </div>

        <div class="p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl transition-all duration-300 reveal">
          <div class="text-4xl mb-6">🌿</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Seasonal Products</h3>
          <p class="text-slate-600 dark:text-silver leading-relaxed">Jhuri automatically highlights fruits and vegetables currently in season in Bangladesh.</p>
        </div>

        <div class="p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl transition-all duration-300 reveal">
          <div class="text-4xl mb-6">📊</div>
          <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">Monthly Summary</h3>
          <p class="text-slate-600 dark:text-silver leading-relaxed">Track your shopping habits and spending patterns over time.</p>
        </div>

        {/* Row 3 */}
        <div class="md:col-span-2 p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl transition-all duration-300 reveal flex flex-col justify-between">
          <div>
            <div class="text-4xl mb-6">📁</div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white mb-4">Smart Archive & Reuse</h3>
            <p class="text-slate-600 dark:text-silver text-lg leading-relaxed">Every completed list is archived. Duplicate any past list in one tap — perfect for weekly routines. Prices carry over so you always have a reference.</p>
          </div>
          <div class="mt-8 self-start px-4 py-1.5 bg-blue-100 dark:bg-blue-900/50 text-blue-700 dark:text-blue-300 text-sm font-bold rounded-full">Time saver</div>
        </div>

        <div class="p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl transition-all duration-300 reveal flex flex-col gap-6">
          <div>
            <div class="text-4xl mb-3">⏰</div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Shopping Reminders</h3>
            <p class="text-slate-600 dark:text-silver text-sm">Set a reminder per list. Get notified on bazar day.</p>
          </div>
          <div>
            <div class="text-4xl mb-3">✏️</div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">Custom Items</h3>
            <p class="text-slate-600 dark:text-silver text-sm">Add anything not in the database permanently to your library.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Screenshots Carousel Section -->
  <section id="screenshots" class="py-32 px-[5vw] relative z-10 overflow-hidden bg-slate-50 dark:bg-black/20 border-t border-slate-200/50 dark:border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-24 reveal">
        <p class="text-sm font-bold tracking-widest uppercase text-indigo-500 mb-3">See it in action</p>
        <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white">
          Designed for<br/>
          <span class="bg-gradient-to-r from-indigo-500 to-blue-400 bg-clip-text text-transparent">real kitchens.</span>
        </h2>
      </div>

      <div class="flex gap-8 overflow-x-auto pb-16 snap-x snap-mandatory hide-scrollbar">
        {[
          { img: '2_home_dark.png', title: 'Home', desc: 'Your lists at a glance' },
          { img: '3_categories.png', title: 'Categories', desc: 'Visual grid, tap to browse' },
          { img: '4_item_picker.png', title: 'Item Picker', desc: 'Search and tap to add' },
          { img: '5_shopping_mode.png', title: 'Shopping Mode', desc: 'Checklist, tap to mark bought' },
          { img: '6_monthly_summary.png', title: 'Monthly Summary', desc: 'Spending insights' }
        ].map((s, i) => (
          <div class={`min-w-[280px] md:min-w-[320px] flex-col items-center text-center snap-center reveal reveal-delay-${i}`}>
            <!-- Perfect Replica Phone Mockup -->
            <div class="screenshot-phone transition-transform hover:-translate-y-2 duration-500 mb-8 mx-auto">
              <div class="screenshot-phone-inner">
                <img src={`https://jhuri.ekushlabs.com/assets/screenshots/${s.img}`} alt={s.title} onerror={`this.src='/assets/screenshots/${s.img}'`} />
              </div>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{s.title}</h3>
            <p class="text-slate-600 dark:text-silver max-w-[220px] mx-auto">{s.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Legal & Support -->
  <section class="py-12 px-[5vw] relative z-10 text-center border-t border-slate-200/50 dark:border-white/5 bg-slate-50 dark:bg-transparent">
    <div class="flex flex-col md:flex-row justify-center items-center gap-6">
      <a href="mailto:ekushlabs@gmail.com" class="text-sm font-bold text-indigo-600 hover:text-indigo-800 dark:text-indigo-400 dark:hover:text-white transition-colors">Support: ekushlabs@gmail.com</a>
      <div class="hidden md:block w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-white/30"></div>
      <a href="/privacy" class="text-sm font-semibold text-slate-500 hover:text-slate-800 dark:text-silver dark:hover:text-white transition-colors">Privacy Policy</a>
      <div class="hidden md:block w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-white/30"></div>
      <a href="/terms" class="text-sm font-semibold text-slate-500 hover:text-slate-800 dark:text-silver dark:hover:text-white transition-colors">Terms of Service</a>
    </div>
  </section>

  <style>
    /* Phone mockup hero */
    .phone-mockup-hero {
      width: 260px;
      height: 576px;
      background: var(--text-primary, #0f172a);
      border-radius: 30px;
      padding: 6px;
      box-shadow: 0 24px 64px rgba(79, 70, 229, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.1);
      position: relative;
    }

    :global(html[data-theme='dark']) .phone-mockup-hero {
      background: #0f172a;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .phone-mockup-hero::before {
      content: '';
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 6px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 100px;
      z-index: 2;
    }

    .phone-screen-hero {
      width: 100%;
      height: 100%;
      background: var(--surface, #f8fafc);
      border-radius: 24px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .phone-screen-hero img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Screenshot phone */
    .screenshot-phone {
      width: 200px;
      height: 432px;
      background: var(--text-primary, #0f172a);
      border-radius: 32px;
      padding: 10px;
      box-shadow: 0 24px 64px rgba(79, 70, 229, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.08);
      position: relative;
      flex-shrink: 0;
    }

    :global(html[data-theme='dark']) .screenshot-phone {
      background: #0f172a;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .screenshot-phone::before {
      content: '';
      position: absolute;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 5px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 100px;
      z-index: 2;
    }

    .screenshot-phone-inner {
      width: 100%;
      height: 100%;
      border-radius: 24px;
      overflow: hidden;
      background: var(--surface, #f8fafc);
    }

    .screenshot-phone-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      display: block;
    }

    /* Animations */
    @keyframes float {
      0%, 100% { transform: translateY(0); }
      50% { transform: translateY(-10px); }
    }
    
    .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-0 { transition-delay: 0ms; }
    .reveal-delay-1 { transition-delay: 100ms; }
    .reveal-delay-2 { transition-delay: 200ms; }
    .reveal-delay-3 { transition-delay: 300ms; }
    
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script>
    const observer = new IntersectionObserver((entries) => { 
      entries.forEach(entry => { 
        if (entry.isIntersecting) { 
          entry.target.classList.add('visible'); 
          observer.unobserve(entry.target); 
        } 
      }); 
    }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
    
    document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
  </script>
</BaseLayout>
