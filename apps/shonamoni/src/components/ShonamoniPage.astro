---
import BaseLayout from '@ekush-labs/ui/src/layouts/BaseLayout.astro';
import { useTranslations, getLangFromUrl, localizeNumber } from '@ekush-labs/ui/src/i18n/utils';

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout 
  title={t('shonamoni.meta.title')} 
  description={t('shonamoni.meta.desc')}
  appName="Shonamoni"
  faviconUrl="/assets/app_logo.png"
  logoUrl="/assets/app_logo.png"
  navLinks={[
    { name: t('shonamoni.features.title_prefix'), href: '#features' },
    { name: t('shonamoni.screenshots.title_prefix'), href: '#screenshots' },
    { name: t('shonamoni.support.title') || 'Support', href: '#support' }
  ]}
>
  <!-- Hero Section -->
  <section id="hero" class="relative pt-32 pb-24 px-[5vw] overflow-hidden min-h-screen flex flex-col lg:flex-row items-center lg:items-start lg:pt-40 gap-16 max-w-7xl mx-auto">
    <!-- Background glows (Shonamoni theme: Purple/Violet) -->
    <div class="absolute top-[20%] left-[10%] w-[50vw] h-[50vw] max-w-[600px] max-h-[600px] bg-[radial-gradient(circle,rgba(139,92,246,0.15)_0%,transparent_70%)] rounded-full blur-[80px] -z-10 animate-[pulse_8s_ease-in-out_infinite]"></div>
    
    <div class="flex-1 reveal">
      <div class="inline-flex items-center gap-2 px-4 py-2 rounded-full bg-purple-50 dark:bg-purple-500/10 border border-purple-200 dark:border-purple-500/20 text-sm font-bold text-purple-700 dark:text-purple-400 mb-8 shadow-sm">
        <span class="w-2 h-2 rounded-full bg-purple-500 animate-pulse"></span>
        {t('shonamoni.hero.badge')}
      </div>
      
      <h1 class="font-display text-6xl md:text-7xl lg:text-8xl font-bold leading-[0.9] tracking-tight text-slate-900 dark:text-white mb-8">
        {t('shonamoni.hero.title1')}<br/>
        <span class="bg-gradient-to-r from-purple-500 to-violet-400 bg-clip-text text-transparent drop-shadow-sm">{t('shonamoni.hero.title_highlight')}</span>
      </h1>
      
      <p class="text-xl text-slate-600 dark:text-silver max-w-[500px] mb-12 leading-relaxed">{t('shonamoni.hero.desc')}</p>
      
      <div class="flex flex-wrap items-center gap-6 mb-16">
        <div class="flex items-center gap-3 px-8 py-4 bg-slate-100 dark:bg-slate-800 border border-slate-200 dark:border-slate-700 text-slate-500 dark:text-slate-400 font-bold rounded-full">
          <svg class="w-6 h-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <circle cx="12" cy="12" r="10" />
            <path d="M12 8v4l3 3" />
          </svg>
          <span class="flex flex-col items-start leading-none">
            <span class="text-[0.65rem] uppercase tracking-wider opacity-80">{t('shonamoni.hero.launching')}</span>
            <span class="text-base">Google Play</span>
          </span>
        </div>
        
        <a href="#features" class="flex items-center gap-2 font-bold text-slate-700 dark:text-white hover:text-purple-500 dark:hover:text-purple-400 transition-colors">
          {t('shonamoni.hero.see_features')}
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12l7 7 7-7" /></svg>
        </a>
      </div>

      <div class="flex items-center gap-8 md:gap-12 text-center">
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">{localizeNumber('2', lang)}</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">{t('shonamoni.stats.languages')}</div>
        </div>
        <div class="w-px h-12 bg-slate-200 dark:bg-white/10"></div>
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">WHO</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">{t('shonamoni.stats.standards')}</div>
        </div>
        <div class="w-px h-12 bg-slate-200 dark:bg-white/10"></div>
        <div>
          <div class="text-4xl font-display font-bold text-slate-900 dark:text-white mb-1">EPI</div>
          <div class="text-xs font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt">{t('shonamoni.stats.vaccine')}</div>
        </div>
      </div>
    </div>

    <!-- Hero Phone Mockup -->
    <div class="flex-1 flex justify-center lg:justify-end reveal reveal-delay-2 perspective-[1000px]">
      <div class="phone-mockup-hero transform rotate-y-[0deg] rotate-x-[0deg] transition-transform duration-700 hover:-translate-y-2">
        <div class="phone-screen-hero">
          <img src="https://shonamoni.ekushlabs.com/assets/screenshots/1_home.jpeg" alt="Shonamoni Home Screen" onerror="this.src='/assets/screenshots/1_home.jpeg'" />
        </div>
      </div>
    </div>
  </section>

  <!-- Features Section -->
  <section id="features" class="py-32 px-[5vw] relative z-10 bg-slate-50/50 dark:bg-black/20 border-y border-slate-200/50 dark:border-white/5">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-24 reveal">
        <p class="text-sm font-bold tracking-widest uppercase text-purple-500 mb-3">{t('shonamoni.features.title_prefix')}</p>
        <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white">
          {t('shonamoni.features.title1')}<br/>
          <span class="bg-gradient-to-r from-purple-500 to-violet-400 bg-clip-text text-transparent">{t('shonamoni.features.title_highlight')}</span>
        </h2>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {[
          { title: t('shonamoni.features.growth'), desc: t('shonamoni.features.growth_desc') },
          { title: t('shonamoni.features.vaccine'), desc: t('shonamoni.features.vaccine_desc') },
          { title: t('shonamoni.features.milestone'), desc: t('shonamoni.features.milestone_desc') },
          { title: t('shonamoni.features.nutrition'), desc: t('shonamoni.features.nutrition_desc') },
          { title: t('shonamoni.features.charts'), desc: t('shonamoni.features.charts_desc') },
          { title: t('shonamoni.features.smart_reminders'), desc: t('shonamoni.features.smart_reminders_desc') },
          { title: t('shonamoni.features.profiles'), desc: t('shonamoni.features.profiles_desc') },
          { title: t('shonamoni.features.bilingual'), desc: t('shonamoni.features.bilingual_desc') },
          { title: t('shonamoni.features.theme'), desc: t('shonamoni.features.theme_desc') }
        ].map((f, i) => (
          <div class={`p-10 rounded-[2rem] bg-white dark:bg-[var(--glass-bg)] border border-slate-200 dark:border-[var(--glass-border)] shadow-sm hover:shadow-xl hover:-translate-y-2 transition-all duration-500 reveal reveal-delay-${i % 3}`}>
            <div class="w-12 h-12 rounded-xl bg-purple-50 dark:bg-black/50 border border-purple-100 dark:border-white/10 flex items-center justify-center mb-6">
              <div class="w-3 h-3 rounded-full bg-purple-500"></div>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-3">{f.title}</h3>
            <p class="text-slate-600 dark:text-silver leading-relaxed">{f.desc}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Screenshots Carousel Section -->
  <section id="screenshots" class="py-32 px-[5vw] relative z-10 overflow-hidden">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-24 reveal">
        <p class="text-sm font-bold tracking-widest uppercase text-purple-500 mb-3">{t('shonamoni.screenshots.title_prefix')}</p>
        <h2 class="font-display text-5xl md:text-6xl font-bold tracking-tight text-slate-900 dark:text-white">
          {t('shonamoni.screenshots.title1')}<br/>
          <span class="bg-gradient-to-r from-purple-500 to-violet-400 bg-clip-text text-transparent">{t('shonamoni.screenshots.title_highlight')}</span>
        </h2>
      </div>

      <div class="relative group">
        <button class="absolute left-0 top-[40%] -translate-y-1/2 -translate-x-4 lg:-translate-x-8 z-10 w-12 h-12 rounded-full bg-white dark:bg-slate-800 shadow-xl border border-slate-200 dark:border-slate-700 hidden md:flex items-center justify-center text-slate-600 dark:text-silver transition-all hover:scale-110 disabled:opacity-0 disabled:pointer-events-none screenshot-prev">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/></svg>
        </button>
        
        <div class="flex gap-8 overflow-x-auto pb-16 snap-x snap-mandatory hide-scrollbar screenshot-container scroll-smooth">
        {[
          { img: '2_growth.jpeg', title: t('shonamoni.screenshots.charts_title'), desc: t('shonamoni.screenshots.charts_desc') },
          { img: '3_vaccines.jpeg', title: t('shonamoni.screenshots.vaccine_title'), desc: t('shonamoni.screenshots.vaccine_desc') },
          { img: '4_milestones.jpeg', title: t('shonamoni.screenshots.milestones_title'), desc: t('shonamoni.screenshots.milestones_desc') },
          { img: '5_nutrition.jpeg', title: t('shonamoni.screenshots.nutrition_title'), desc: t('shonamoni.screenshots.nutrition_desc') }
        ].map((s, i) => (
          <div class={`min-w-[280px] md:min-w-[320px] flex-col items-center text-center snap-center reveal reveal-delay-${i}`}>
            <!-- Perfect Replica Phone Mockup -->
            <div class="screenshot-phone transition-transform hover:-translate-y-2 duration-500 mb-8 mx-auto">
              <div class="screenshot-phone-inner">
                <img src={`https://shonamoni.ekushlabs.com/assets/screenshots/${s.img}`} alt={s.title} onerror={`this.src='/assets/screenshots/${s.img}'`} />
              </div>
            </div>
            <h3 class="text-xl font-bold text-slate-900 dark:text-white mb-2">{s.title}</h3>
            <p class="text-slate-600 dark:text-silver max-w-[220px] mx-auto">{s.desc}</p>
          </div>
        ))}
        </div>

        <button class="absolute right-0 top-[40%] -translate-y-1/2 translate-x-4 lg:translate-x-8 z-10 w-12 h-12 rounded-full bg-white dark:bg-slate-800 shadow-xl border border-slate-200 dark:border-slate-700 hidden md:flex items-center justify-center text-slate-600 dark:text-silver transition-all hover:scale-110 disabled:opacity-0 disabled:pointer-events-none screenshot-next">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        </button>
      </div>
    </div>
  </section>

  <!-- Coming Soon Banner -->
  <section class="py-24 px-[5vw] relative z-10 bg-purple-600 dark:bg-purple-900 text-white text-center">
    <div class="max-w-3xl mx-auto reveal">
      <div class="inline-block px-4 py-1.5 bg-white/20 rounded-full text-sm font-bold mb-6">{t('shonamoni.coming_soon.badge')}</div>
      <h2 class="font-display text-4xl md:text-5xl font-bold mb-6">{t('shonamoni.coming_soon.title')}</h2>
      <p class="text-lg text-white/80 mb-10 max-w-xl mx-auto">{t('shonamoni.coming_soon.desc')}</p>
      <a href="https://ekushlabs.com" class="inline-flex items-center gap-2 px-8 py-4 bg-white text-purple-700 font-bold rounded-full hover:bg-slate-50 transition-colors">
        {t('shonamoni.coming_soon.visit')}
      </a>
    </div>
  </section>

  <!-- Legal & Support -->
  <section id="support" class="py-12 px-[5vw] relative z-10 text-center border-t border-slate-200/50 dark:border-white/5 bg-slate-50 dark:bg-transparent">
    <div class="flex flex-col md:flex-row justify-center items-center gap-6">
      <a href="mailto:ekushlabs@gmail.com" class="text-sm font-bold text-purple-600 hover:text-purple-800 dark:text-purple-400 dark:hover:text-white transition-colors">{t('shonamoni.support.email')}</a>
      <div class="hidden md:block w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-white/30"></div>
      <a href="/privacy" class="text-sm font-semibold text-slate-500 hover:text-slate-800 dark:text-silver dark:hover:text-white transition-colors">{t('shonamoni.privacy')}</a>
      <div class="hidden md:block w-1.5 h-1.5 rounded-full bg-slate-300 dark:bg-white/30"></div>
      <a href="/terms" class="text-sm font-semibold text-slate-500 hover:text-slate-800 dark:text-silver dark:hover:text-white transition-colors">{t('shonamoni.terms')}</a>
    </div>
  </section>

  <style>
    /* Phone mockup hero */
    .phone-mockup-hero {
      width: 260px;
      height: 576px;
      background: var(--text-primary, #0f172a);
      border-radius: 30px;
      padding: 6px;
      box-shadow: 0 24px 64px rgba(139, 92, 246, 0.2), 0 0 0 1px rgba(0, 0, 0, 0.1);
      position: relative;
    }

    :global(html[data-theme='dark']) .phone-mockup-hero {
      background: #0f172a;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.6), 0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .phone-mockup-hero::before {
      content: '';
      position: absolute;
      top: 16px;
      left: 50%;
      transform: translateX(-50%);
      width: 80px;
      height: 6px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 100px;
      z-index: 2;
    }

    .phone-screen-hero {
      width: 100%;
      height: 100%;
      background: var(--surface, #f8fafc);
      border-radius: 24px;
      overflow: hidden;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .phone-screen-hero img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      display: block;
    }

    /* Screenshot phone */
    .screenshot-phone {
      width: 200px;
      height: 432px;
      background: var(--text-primary, #0f172a);
      border-radius: 32px;
      padding: 10px;
      box-shadow: 0 24px 64px rgba(139, 92, 246, 0.15), 0 0 0 1px rgba(0, 0, 0, 0.08);
      position: relative;
      flex-shrink: 0;
    }

    :global(html[data-theme='dark']) .screenshot-phone {
      background: #0f172a;
      box-shadow: 0 24px 64px rgba(0, 0, 0, 0.5), 0 0 0 1px rgba(255, 255, 255, 0.1);
    }

    .screenshot-phone::before {
      content: '';
      position: absolute;
      top: 12px;
      left: 50%;
      transform: translateX(-50%);
      width: 60px;
      height: 5px;
      background: rgba(255, 255, 255, 0.15);
      border-radius: 100px;
      z-index: 2;
    }

    .screenshot-phone-inner {
      width: 100%;
      height: 100%;
      border-radius: 24px;
      overflow: hidden;
      background: var(--surface, #f8fafc);
    }

    .screenshot-phone-inner img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: top;
      display: block;
    }

    /* Animations */
    .reveal { opacity: 0; transform: translateY(30px); transition: all 0.8s cubic-bezier(0.16, 1, 0.3, 1); }
    .reveal.visible { opacity: 1; transform: translateY(0); }
    .reveal-delay-0 { transition-delay: 0ms; }
    .reveal-delay-1 { transition-delay: 100ms; }
    .reveal-delay-2 { transition-delay: 200ms; }
    .reveal-delay-3 { transition-delay: 300ms; }
    
    .hide-scrollbar::-webkit-scrollbar { display: none; }
    .hide-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>

  <script>
    function initReveal() {
      const observer = new IntersectionObserver((entries) => { 
        entries.forEach(entry => { 
          if (entry.isIntersecting) { 
            entry.target.classList.add('visible'); 
            observer.unobserve(entry.target); 
          } 
        }); 
      }, { threshold: 0.1, rootMargin: '0px 0px -50px 0px' });
      document.querySelectorAll('.reveal').forEach(el => observer.observe(el));
      
      document.querySelectorAll('.screenshot-container').forEach(container => {
        const prevBtn = container.parentElement?.querySelector('.screenshot-prev') as HTMLButtonElement;
        const nextBtn = container.parentElement?.querySelector('.screenshot-next') as HTMLButtonElement;
        
        if(prevBtn && nextBtn) {
          prevBtn.addEventListener('click', () => {
            container.scrollBy({ left: -320, behavior: 'smooth' });
          });
          nextBtn.addEventListener('click', () => {
            container.scrollBy({ left: 320, behavior: 'smooth' });
          });
          
          const updateBtns = () => {
            prevBtn.disabled = container.scrollLeft <= 0;
            nextBtn.disabled = container.scrollLeft >= container.scrollWidth - container.clientWidth - 10;
          };
          container.addEventListener('scroll', updateBtns);
          window.addEventListener('resize', updateBtns);
          setTimeout(updateBtns, 100);
        }
      });
    }
    initReveal();
    document.addEventListener('astro:page-load', initReveal);
  </script>
</BaseLayout>
