---
import BaseLayout from "@ekush-labs/ui/src/layouts/BaseLayout.astro";
import {
  getLangFromUrl,
  useTranslations,
  localizeNumber,
} from "@ekush-labs/ui/src/i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<BaseLayout
  title={t("main.meta.title")}
  description={t("main.hero.desc")}
  appName={t("app.name")}
  isMainPortal={true}
>
  <!-- Structured Data -->
  <script type="application/ld+json" is:inline>
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": "EkushLabs",
      "url": "https://ekushlabs.com",
      "logo": "https://ekushlabs.com/assets/logo.png",
      "description": "A modern app studio building simple, reliable, and privacy-focused utility tools for everyday life.",
      "sameAs": ["https://ekushlabs.com"],
      "contactPoint": {
        "@type": "ContactPoint",
        "email": "ekushlabs@gmail.com"
      }
    }
  </script>

  <!-- Hero -->
  <section
    id="hero"
    class="relative pt-40 pb-20 px-[5vw] min-h-screen flex flex-col justify-center items-center overflow-hidden"
  >
    <!-- Animated background glowing orbs -->
    <div
      class="absolute top-1/3 left-1/4 w-[60vw] h-[60vw] max-w-[600px] max-h-[600px] -translate-x-1/2 -translate-y-1/2 bg-primary-start/20 dark:bg-primary-start/15 rounded-full blur-[80px] -z-10 mix-blend-multiply dark:mix-blend-screen animate-[pulse_8s_ease-in-out_infinite]"
    >
    </div>
    <div
      class="absolute bottom-1/4 right-1/4 w-[50vw] h-[50vw] max-w-[500px] max-h-[500px] bg-secondary-start/20 dark:bg-secondary-start/15 rounded-full blur-[80px] -z-10 mix-blend-multiply dark:mix-blend-screen animate-[pulse_10s_ease-in-out_infinite_1s]"
    >
    </div>

    <div class="text-center z-10 max-w-4xl mx-auto">
      <div
        class="inline-flex items-center gap-2 px-6 py-3 rounded-full bg-slate-100/80 dark:bg-white/5 border border-slate-200 dark:border-white/10 backdrop-blur-md mb-8 reveal shadow-sm"
      >
        <span class="w-3 h-3 rounded-full bg-primary-mid animate-pulse"></span>
        <span
          class="text-lg font-bold tracking-widest uppercase text-slate-700 dark:text-silver-lt"
          >{t("main.hero.badge")}</span
        >
      </div>

      <div class="reveal reveal-delay-1 mb-10">
        <h1
          class="font-display text-[clamp(4rem,10vw,8rem)] leading-[0.85] font-bold tracking-tight text-slate-900 dark:text-white drop-shadow-sm mb-16"
        >
          <span
            class="bg-gradient-to-r from-primary-start to-primary-end bg-clip-text text-transparent"
            >{t("app.ekush")}</span
          >
          <span
            class="bg-gradient-to-r from-secondary-start to-secondary-end bg-clip-text text-transparent"
            >{t("app.labs")}</span
          >
        </h1>
        <div id="hero-swap" class="grid w-full">
          <!-- Tagline: visible at top -->
          <div
            id="hero-tagline"
            class="transition-all duration-700 ease-out [grid-area:1/1]"
          >
            <p
              class="text-3xl md:text-5xl font-bold text-slate-700 dark:text-silver tracking-widest"
            >
              {t("main.hero.tagline")}
            </p>
          </div>

          <!-- Description + CTAs: replaces tagline on scroll -->
          <div
            id="hero-reveal-content"
            class="flex flex-col items-center justify-start opacity-0 translate-y-10 transition-all duration-700 ease-out pointer-events-none [grid-area:1/1]"
          >
            <p
              class="text-lg md:text-2xl text-slate-600 dark:text-silver max-w-2xl mx-auto mb-12 md:mb-20 font-medium leading-relaxed tracking-wider"
            >
              {t("main.hero.desc")}
            </p>

            <div
              class="flex flex-col sm:flex-row items-center justify-center gap-6"
            >
              <a
                href="#apps"
                class="group relative px-8 py-4 bg-slate-900 dark:bg-white text-white dark:text-slate-900 font-bold rounded-full overflow-hidden shadow-[0_8px_30px_rgba(0,0,0,0.1)] dark:shadow-[0_8px_30px_rgba(255,255,255,0.15)] hover:shadow-xl hover:-translate-y-1 transition-all duration-400"
              >
                <div
                  class="absolute inset-0 bg-gradient-to-r from-primary-start to-primary-end opacity-0 group-hover:opacity-100 transition-opacity duration-400"
                >
                </div>
                <span
                  class="relative flex items-center gap-3 group-hover:text-white transition-colors duration-400"
                >
                  {t("main.hero.explore")}
                  <svg
                    class="w-5 h-5 group-hover:translate-x-1 transition-transform"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg
                  >
                </span>
              </a>
              <a
                href="#about"
                class="px-8 py-4 bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 text-slate-700 dark:text-white font-bold rounded-full backdrop-blur-md hover:bg-slate-200 dark:hover:bg-white/10 transition-colors duration-400"
              >
                {t("main.hero.learn")}
              </a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script is:inline>
    // Handle scroll crossfade: tagline <-> description (in-place swap)
    document.addEventListener("DOMContentLoaded", () => {
      const heroRevealContent = document.getElementById("hero-reveal-content");
      const heroTagline = document.getElementById("hero-tagline");
      if (heroRevealContent && heroTagline) {
        const handleHeroScroll = () => {
          if (window.scrollY > 50) {
            // Scrolled: hide tagline, show description in its place
            heroTagline.classList.add("opacity-0", "-translate-y-6");
            heroTagline.classList.remove("opacity-100", "translate-y-0");
            heroRevealContent.classList.remove(
              "opacity-0",
              "translate-y-10",
              "pointer-events-none",
            );
            heroRevealContent.classList.add(
              "opacity-100",
              "translate-y-0",
              "pointer-events-auto",
            );
          } else {
            // Top: show tagline, hide description
            heroTagline.classList.remove("opacity-0", "-translate-y-6");
            heroTagline.classList.add("opacity-100", "translate-y-0");
            heroRevealContent.classList.add(
              "opacity-0",
              "translate-y-10",
              "pointer-events-none",
            );
            heroRevealContent.classList.remove(
              "opacity-100",
              "translate-y-0",
              "pointer-events-auto",
            );
          }
        };
        window.addEventListener("scroll", handleHeroScroll, { passive: true });
        handleHeroScroll(); // Check initial state
      }
    });
  </script>

  <!-- Apps Grid Showcase -->
  <section
    id="apps"
    class="py-24 px-[5vw] relative z-10 bg-slate-50/50 dark:bg-black/20 backdrop-blur-sm border-y border-slate-200 dark:border-white/5"
  >
    <div class="max-w-7xl mx-auto">
      <div class="flex flex-col items-center text-center mb-16 gap-8 reveal">
        <div class="max-w-3xl">
          <h2
            class="font-display text-5xl md:text-6xl font-semibold tracking-wide pt-3 mb-4 leading-normal overflow-visible text-slate-900 dark:bg-gradient-to-r dark:from-slate-400 dark:via-slate-200 dark:to-white dark:bg-clip-text dark:text-transparent"
          >
            {t("main.ecosystem.title")}
          </h2>
          <p class="text-2xl text-slate-600 dark:text-silver">
            {t("main.ecosystem.desc")}
          </p>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Ekush Ponji Card -->
        <a
          href="https://ekushponji.ekushlabs.com"
          class="group relative flex flex-col p-8 rounded-3xl bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 overflow-hidden reveal"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-primary-start/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
          <div class="flex justify-between items-start mb-12 relative z-10">
            <div
              class="w-16 h-16 rounded-2xl bg-slate-50 dark:bg-black/50 border border-slate-100 dark:border-white/10 flex items-center justify-center shadow-inner overflow-hidden group-hover:scale-110 transition-transform duration-500"
            >
              <img
                src="/assets/ponji_logo.png"
                alt="Ponji"
                class="w-10 h-10 object-contain drop-shadow-md"
                onerror="this.src='https://ekushponji.ekushlabs.com/assets/icon.png'"
              />
            </div>
            <span
              class="px-3 py-1 bg-primary-mid/10 text-primary-mid text-xs font-bold tracking-widest uppercase rounded-full"
              >{t("main.badge.calendar")}</span
            >
          </div>
          <h3 class="font-display text-4xl text-slate-900 dark:text-white mb-3">
            {t("app.ekushponji")}
          </h3>
          <p
            class="text-slate-600 dark:text-silver mb-8 flex-grow leading-relaxed"
          >
            {t("main.ponji.desc")}
          </p>
          <div
            class="flex items-center gap-2 text-sm font-bold text-slate-500 dark:text-silver group-hover:text-primary-start transition-colors mt-auto border-t border-slate-100 dark:border-white/5 pt-6"
          >
            <span
              class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_#10B981]"
            ></span>
            {t("main.play_store")}
          </div>
        </a>

        <!-- Jhuri Card -->
        <a
          href="https://jhuri.ekushlabs.com"
          class="group relative flex flex-col p-8 rounded-3xl bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 overflow-hidden reveal reveal-delay-1"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-secondary-start/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
          <div class="flex justify-between items-start mb-12 relative z-10">
            <div
              class="w-16 h-16 rounded-2xl bg-slate-50 dark:bg-black/50 border border-slate-100 dark:border-white/10 flex items-center justify-center shadow-inner overflow-hidden group-hover:scale-110 transition-transform duration-500"
            >
              <img
                src="/assets/jhuri_logo.png"
                alt="Jhuri"
                class="w-10 h-10 object-contain drop-shadow-md"
                onerror="this.src='https://jhuri.ekushlabs.com/assets/app_logo.png'"
              />
            </div>
            <span
              class="px-3 py-1 bg-secondary-start/10 text-secondary-start text-xs font-bold tracking-widest uppercase rounded-full"
              >{t("main.badge.grocery")}</span
            >
          </div>
          <h3 class="font-display text-4xl text-slate-900 dark:text-white mb-3">
            {t("app.jhuri")}
          </h3>
          <p
            class="text-slate-600 dark:text-silver mb-8 flex-grow leading-relaxed"
          >
            {t("main.jhuri.desc")}
          </p>
          <div
            class="flex items-center gap-2 text-sm font-bold text-slate-500 dark:text-silver group-hover:text-secondary-start transition-colors mt-auto border-t border-slate-100 dark:border-white/5 pt-6"
          >
            <span
              class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_#10B981]"
            ></span>
            {t("main.play_store")}
          </div>
        </a>

        <!-- Shonamoni Card -->
        <a
          href="https://shonamoni.ekushlabs.com"
          class="group relative flex flex-col p-8 rounded-3xl bg-white dark:bg-white/5 border border-slate-200 dark:border-white/10 shadow-sm hover:shadow-2xl hover:-translate-y-2 transition-all duration-500 overflow-hidden reveal reveal-delay-2"
        >
          <div
            class="absolute inset-0 bg-gradient-to-br from-amber-500/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
          >
          </div>
          <div class="flex justify-between items-start mb-12 relative z-10">
            <div
              class="w-16 h-16 rounded-2xl bg-slate-50 dark:bg-black/50 border border-slate-100 dark:border-white/10 flex items-center justify-center shadow-inner overflow-hidden group-hover:scale-110 transition-transform duration-500"
            >
              <img
                src="/assets/shonamoni_logo.png"
                alt="Shonamoni"
                class="w-10 h-10 object-contain drop-shadow-md"
                onerror="this.src='https://shonamoni.ekushlabs.com/assets/app_logo.png'"
              />
            </div>
            <span
              class="px-3 py-1 bg-amber-500/10 text-amber-600 dark:text-amber-400 text-xs font-bold tracking-widest uppercase rounded-full border border-amber-500/20"
              >{t("main.badge.health")}</span
            >
          </div>
          <h3 class="font-display text-4xl text-slate-900 dark:text-white mb-3">
            {t("app.shonamoni")}
          </h3>
          <p
            class="text-slate-600 dark:text-silver mb-8 flex-grow leading-relaxed"
          >
            {t("main.shonamoni.desc")}
          </p>
          <div
            class="flex items-center gap-2 text-sm font-bold text-slate-500 dark:text-silver group-hover:text-amber-500 transition-colors mt-auto border-t border-slate-100 dark:border-white/5 pt-6"
          >
            <span
              class="w-2 h-2 rounded-full bg-green-500 shadow-[0_0_8px_#10B981]"
            ></span>
            {t("main.play_store")}
          </div>
        </a>
      </div>
      <div class="flex justify-end pt-8 reveal reveal-delay-2 hidden md:flex">
        <a
          href="https://tools.ekushlabs.com"
          class="shrink-0 flex items-center gap-2 text-primary-start font-bold hover:underline underline-offset-4"
        >
          {t("main.ecosystem.view_all")}
          <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
            stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"></path></svg
          >
        </a>
      </div>
    </div>
  </section>

  <!-- Bento Box Features / About -->
  <section id="about" class="py-24 px-[5vw] relative z-10">
    <div class="max-w-7xl mx-auto">
      <div class="text-center mb-20 reveal">
        <h2
          class="font-display text-5xl md:text-7xl font-bold tracking-tight text-slate-900 dark:text-white mb-4"
        >
          {t("main.how.title")}
        </h2>
        <p class="text-2xl text-slate-600 dark:text-silver max-w-3xl mx-auto">
          {t("main.how.desc")}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Flutter Apps -->
        <div
          class="col-span-1 md:col-span-2 bg-gradient-to-br from-[#027DFD]/10 to-[#0553B1]/5 dark:from-[#027DFD]/20 dark:to-[#0553B1]/10 p-10 rounded-[2rem] border border-[#027DFD]/20 dark:border-[#027DFD]/30 relative overflow-hidden reveal"
        >
          <div
            class="absolute -right-20 -bottom-20 w-64 h-64 bg-[#027DFD]/15 rounded-full blur-[60px] pointer-events-none"
          >
          </div>
          <div class="flex items-center gap-3 mb-8 relative z-10">
            <div
              class="w-14 h-14 rounded-2xl bg-white dark:bg-black/50 border border-slate-200 dark:border-white/10 flex items-center justify-center shadow-sm"
            >
              <svg
                class="w-7 h-7 text-[#027DFD]"
                viewBox="0 0 24 24"
                fill="currentColor"
                ><path
                  d="M14.314 0L2.3 12 6 15.7 21.684.013h-7.357zm.014 11.072L7.857 17.53l6.47 6.47H21.7l-6.46-6.468 6.46-6.46h-7.37z"
                ></path></svg
              >
            </div>
            <span
              class="px-3 py-1 bg-[#027DFD]/10 text-[#027DFD] text-xs font-bold tracking-widest uppercase rounded-full"
              >{t("main.badge.mobile")}</span
            >
          </div>
          <h3 class="text-3xl font-bold text-slate-900 dark:text-white mb-4">
            {t("main.how.mobile.title")}
          </h3>
          <p class="text-lg text-slate-600 dark:text-silver max-w-lg">
            {t("main.how.mobile.desc")}
          </p>
          <div class="flex flex-wrap gap-3 mt-8">
            <span
              class="px-3 py-1.5 rounded-full bg-white/80 dark:bg-white/10 text-slate-700 dark:text-silver-lt text-xs font-bold border border-slate-200 dark:border-white/10"
              >Dart</span
            >
            <span
              class="px-3 py-1.5 rounded-full bg-white/80 dark:bg-white/10 text-slate-700 dark:text-silver-lt text-xs font-bold border border-slate-200 dark:border-white/10"
              >Flutter</span
            >
            <span
              class="px-3 py-1.5 rounded-full bg-white/80 dark:bg-white/10 text-slate-700 dark:text-silver-lt text-xs font-bold border border-slate-200 dark:border-white/10"
              >Material 3</span
            >
            <span
              class="px-3 py-1.5 rounded-full bg-white/80 dark:bg-white/10 text-slate-700 dark:text-silver-lt text-xs font-bold border border-slate-200 dark:border-white/10"
              >Play Store</span
            >
          </div>
        </div>

        <!-- Stats Column -->
        <div class="col-span-1 flex flex-col gap-6">
          <div
            class="bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 p-8 rounded-[2rem] flex flex-col justify-center text-center flex-1 reveal reveal-delay-1"
          >
            <h4
              class="font-display text-7xl text-slate-900 dark:text-white mb-1 leading-none"
            >
              {localizeNumber("2", lang)}
            </h4>
            <p
              class="text-sm font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt"
            >
              {t("main.how.stats.apps")}
            </p>
          </div>
          <div
            class="bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 p-8 rounded-[2rem] flex flex-col justify-center text-center flex-1 reveal reveal-delay-2"
          >
            <h4 class="font-display text-7xl text-amber-500 mb-1 leading-none">
              {localizeNumber("1", lang)}
            </h4>
            <p
              class="text-sm font-bold tracking-widest uppercase text-slate-500 dark:text-silver-lt"
            >
              {t("main.how.stats.testing")}
            </p>
          </div>
        </div>

        <!-- Web Ecosystem -->
        <div
          class="col-span-1 bg-slate-100 dark:bg-white/5 border border-slate-200 dark:border-white/10 p-10 rounded-[2rem] reveal reveal-delay-2"
        >
          <div class="flex items-center gap-4 mb-6">
            <div
              class="w-14 h-14 shrink-0 rounded-2xl bg-white dark:bg-black/50 border border-slate-200 dark:border-white/10 flex items-center justify-center shadow-sm"
            >
              <svg
                class="w-7 h-7 text-primary-start"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                stroke-width="2"
                ><path d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg
              >
            </div>
            <h3 class="text-2xl font-bold text-slate-900 dark:text-white">
              {t("main.how.web.title")}
            </h3>
          </div>

          <p class="text-lg text-slate-600 dark:text-silver mb-6">
            {t("main.how.web.desc")}
          </p>
          <div class="flex flex-wrap gap-2">
            <span
              class="px-3 py-1.5 rounded-full bg-white/80 dark:bg-white/10 text-slate-700 dark:text-silver-lt text-xs font-bold border border-slate-200 dark:border-white/10"
              >Astro</span
            >
            <span
              class="px-3 py-1.5 rounded-full bg-white/80 dark:bg-white/10 text-slate-700 dark:text-silver-lt text-xs font-bold border border-slate-200 dark:border-white/10"
              >Svelte</span
            >
            <span
              class="px-3 py-1.5 rounded-full bg-white/80 dark:bg-white/10 text-slate-700 dark:text-silver-lt text-xs font-bold border border-slate-200 dark:border-white/10"
              >Tailwind</span
            >
          </div>
        </div>

        <!-- Privacy + Unified Ecosystem -->
        <div
          class="col-span-1 md:col-span-2 bg-slate-900 dark:bg-black/40 border border-slate-800 dark:border-white/10 p-10 rounded-[2rem] text-white reveal reveal-delay-3"
        >
          <div class="flex flex-col md:flex-row gap-12">
            <div class="flex-1">
              <div class="flex items-center gap-4 mb-4">
                <div
                  class="w-14 h-14 shrink-0 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center"
                >
                  <svg
                    class="w-7 h-7 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    ><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"
                    ></path></svg
                  >
                </div>
                <h3 class="text-2xl font-bold">
                  {t("main.how.privacy.title")}
                </h3>
              </div>
              <p class="text-lg text-slate-300">{t("main.how.privacy.desc")}</p>
            </div>

            <div class="flex-1">
              <div class="flex items-center gap-4 mb-4">
                <div
                  class="w-14 h-14 shrink-0 rounded-2xl bg-white/10 border border-white/20 flex items-center justify-center"
                >
                  <svg
                    class="w-7 h-7 text-white"
                    fill="none"
                    stroke="currentColor"
                    viewBox="0 0 24 24"
                    stroke-width="2"
                    ><path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      d="M4 5a1 1 0 011-1h14a1 1 0 011 1v2a1 1 0 01-1 1H5a1 1 0 01-1-1V5zM4 13a1 1 0 011-1h6a1 1 0 011 1v6a1 1 0 01-1 1H5a1 1 0 01-1-1v-6zM16 13a1 1 0 011-1h2a1 1 0 011 1v6a1 1 0 01-1 1h-2a1 1 0 01-1-1v-6z"
                    ></path></svg
                  >
                </div>
                <h3 class="text-2xl font-bold">
                  {t("main.how.design.title")}
                </h3>
              </div>
              <p class="text-lg text-slate-300">{t("main.how.design.desc")}</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modern CTA Section -->
  <section id="contact" class="py-24 px-[5vw] relative z-10 text-center">
    <div
      class="max-w-4xl mx-auto bg-gradient-to-r from-primary-start to-primary-end p-[1px] rounded-[3rem] reveal"
    >
      <div class="bg-slate-50 dark:bg-navy rounded-[calc(3rem-1px)] py-20 px-8">
        <h2
          class="font-display text-5xl md:text-7xl font-bold tracking-tight text-slate-900 dark:text-white mb-6"
        >
          {t("main.contact.title")}
